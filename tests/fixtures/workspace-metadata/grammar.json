          "key": "roadmap/q1",
          "line": 2,
          "excerpt": "Welcome #Roadmap/Q1 @Desk +Daisy"
        },
        {
          "source": "#Release",
          "key": "release",
          "line": 3,
          "excerpt": "- [ ] Ship #Release due:2026-02-28 scheduled:2026-02-01 p:high"
        }
      ],
      "contexts": [
        {
          "source": "@Desk",
          "key": "desk",
          "line": 2,
          "excerpt": "Welcome #Roadmap/Q1 @Desk +Daisy"
        },
        {
          "source": "@Team",
          "key": "team",
          "line": 4,
          "excerpt": "- [x] Review @Team +Daisy p:medium"
        }
      ],
      "projects": [
        {
          "source": "+Daisy",
          "key": "daisy",
          "line": 2,
          "excerpt": "Welcome #Roadmap/Q1 @Desk +Daisy"
        },
        {
          "source": "+Daisy",
          "key": "daisy",
          "line": 4,
          "excerpt": "- [x] Review @Team +Daisy p:medium"
        }
      ],
      "tasks": [
        {
          "line": 3,
          "text": "Ship #Release",
          "checked": false,
          "due": "2026-02-28",
          "scheduled": "2026-02-01",
          "priority": "high",
          "tokens": [
            {
              "kind": "tags",
              "source": "#Release",
              "key": "release",
              "line": 3,
              "excerpt": "- [ ] Ship #Release due:2026-02-28 scheduled:2026-02-01 p:high"
            }
          ],
          "source": "Ship #Release due:2026-02-28 scheduled:2026-02-01 p:high"
        },
        {
          "line": 4,
          "text": "Review @Team +Daisy",
