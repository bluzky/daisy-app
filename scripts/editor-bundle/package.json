{
  "name": "daisy-editor-bundle",
  "private": true,
  "type": "module",
  "description": "Builds CodeMirror editor and workspace metadata extractor bundles in daisy/Vendor. Run `npm ci && npm run build` after changing entry-cm.js, src/, or bumping deps.",
